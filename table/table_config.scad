// table/table_config.scad — 新项目设计尺寸（单位 mm）
//
// 约定：
//   1. 左右框 / 拉结共用的手填量 →「主参数」
//   2. 注释写清：相对位置 + 作用
//   3. 能算的一律派生；仅某框特殊时才在分框架区手填覆盖
//
// 管件标准、搭接公式、legHeight 等见 standards.scad（须先 include 本文件）

// =============================================================================
// 主参数 — 整桌外形
// =============================================================================

// 桌面外轮廓：+X 长、+Y 深（宽）、+Z 上
// 作用：桌面板外包；骨架跨距见 frameSpanLength（可短于板长，右侧悬出）
table_length = 2560;   // 桌面板长（X）；相对骨架跨距向右多出 300
table_width  = 600;    // 桌面板深（Y）

// 骨架沿 X 的布置跨距（左缘与桌板对齐；右缘按此值，不随板长外伸）
// 柱心外包 frameLength = 本值 − 2×frameInset；右框原点据此计算
frameSpanLength = 2260;

// 桌板右后角开洞（俯视右上）：横向沿 +X、纵向沿 +Y；贴齐内角，向外扩切不留边框
tabletopCutoutX = 300;        // 横向洞宽（板内）
tabletopCutoutY = 270;        // 纵向洞深（板内）
tabletopCutoutOvercutMm = 20; // 向板外 +X/+Y 再切掉的量（去掉外缘残边）

// 桌板外轮廓圆角：左前 / 左后 / 右前 R；右后为开洞角，直角
tabletopCornerR = 5;
// 桌面板厚（mm）
// 位置：桌面顶面以下；作用：桌面顶 = 框架顶 + 本值
tabletopThickness = 25;

// 地面 → 桌面底 / 框架顶 / 顶法兰承面（不含桌面板）
frameClearHeight = 740;

// 地面 → 桌面顶面
table_height = frameClearHeight + tabletopThickness;

// =============================================================================
// 主参数 — 桌脚（左右框共用）
// =============================================================================

// 落地法兰盘顶 → 下四通/三通之间的脚短管「下料长度」（须整厘米 xx0）
// 位置：立柱最下段直管；作用：决定脚堆叠高度；净长 / legHeight 在 standards.scad 计算
footPipeCutMm = 80;

// 桌面边到框架柱心预留（每侧 mm）
// 位置：桌面外轮廓向内到柱心；须 ≥ 法兰半径，否则顶/底法兰探出板外
// DN15 法兰外径 65 → 半径 32.5；取 80（外缘到板边净空约 47.5）
frameInset = 80;

// =============================================================================
// 主参数 — 左右框架拉结 / 垂挂（共用）
// =============================================================================

// 顶平面四通外缘 ↔ 拉结三通外缘之间的垂挂直管净长（mm）
// 位置：左右框朝桌心一侧立柱顶部；作用：决定 crossTieZ；两端停在管件搭接外缘
hangPipeNetMm = 100;

// =============================================================================
// 右框架参数（简易机柜侧：宽 505×高 333 机柜）
// =============================================================================

// 右框架左右立柱柱心距（沿 +X，mm）— 前缘跨距；后缘因右后柱不右移而缩短
// 机柜宽 505 + 两侧各 10 + DN15 管径 ≈546 → 取整 550
rightFrameWidth = 550;

// 左前/左后/右前立柱相对「原右后柱对齐网」的右移量（mm）；右后柱不移以躲开开洞立柱
rightFrameShiftX = 300;

// 右框架底部框高度：地面 → 下框上四通中心（上圈横管标高，mm）
// 机柜高 333：340 不够，取 350
rightBottomFrameHeight = 350;

// =============================================================================
// 左框架参数（电脑机箱侧；单层：底圈 + 右缘垂挂，无中间横拉层）
// =============================================================================

// 左框架左右立柱柱心距（沿 +X，mm）— 放普通中塔
leftFrameWidth = 300;

// =============================================================================
// 派生（由主参数计算，勿手改；特殊覆盖写在分框架区）
// =============================================================================

// 框架顶面 Z = 桌面底 = 顶内丝法兰承面（地面起算；= frameClearHeight）
frameHeight = frameClearHeight;

// 框架平面外包（柱心可用范围；X 按骨架跨距，Y 按桌深）
frameLength = frameSpanLength - 2 * frameInset;  // 沿 X（不含板右侧悬出）
frameWidth  = table_width  - 2 * frameInset;     // 沿 Y（桌深方向）

// crossTieZ 见 standards.scad（由顶三通标高 − 垂挂直管算出）
