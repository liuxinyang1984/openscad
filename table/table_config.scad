// table/table_config.scad — 新项目设计尺寸（单位 mm）
//
// 约定：
//   1. 左右框 / 拉结共用的手填量 →「主参数」
//   2. 注释写清：相对位置 + 作用
//   3. 能算的一律派生；仅某框特殊时才在分框架区手填覆盖
//
// 管件标准、搭接公式、legHeight 等见 standards.scad（须先 include 本文件）

// =============================================================================
// 主参数 — 整桌外形
// =============================================================================

// 桌面外轮廓：+X 长、+Y 深（宽）、+Z 上
// 作用：整桌外包尺寸；框架柱距由此与 inset 派生
table_length = 2000;   // 地面俯视：桌面长边（X）
table_width  = 700;    // 地面俯视：桌面短边 / 桌深（Y）
table_height = 700;    // 地面 → 桌面顶面（Z）

// 桌面边到框架柱心外缘预留（每侧 mm）
// 位置：桌面外轮廓向内；作用：避免法兰贴边，派生 frameLength / frameWidth
frameInset = 15;

// 桌面板厚（mm）
// 位置：桌面顶面以下；作用：框架顶 / 顶法兰承面 = table_height − 本值
tabletopThickness = 25;

// =============================================================================
// 主参数 — 桌脚（左右框共用）
// =============================================================================

// 落地法兰盘顶 → 下四通/三通之间的脚短管「下料长度」（须整厘米 xx0）
// 位置：立柱最下段直管；作用：决定脚堆叠高度；净长 / legHeight 在 standards.scad 计算
footPipeCutMm = 80;

// =============================================================================
// 主参数 — 左右框架拉结（共用）
// =============================================================================

// 左缘「顶三通」与「拉结三通」之间用对丝（pipe_link）连接，无直管；
// 拉结标高由顶三通 − 对丝 − 搭接在 standards.scad 算出。


// =============================================================================
// 右框架参数（简易机柜侧：宽 505×高 333 机柜）
// =============================================================================

// 右框架左右立柱柱心距（沿 +X，mm）
// 位置：右框局部 x=0 → x=本值；作用：决定前后横拉净长 / 下料
// 机柜宽 505 + 两侧各 10 + DN15 管径 ≈546 → 取整 550
rightFrameWidth = 550;

// 右框架底部框高度：地面 → 下框上四通中心（上圈横管标高，mm）
// 机柜高 333：340 不够，取 350
rightBottomFrameHeight = 350;

// =============================================================================
// 左框架参数（电脑机箱侧；单层：底圈 + 右缘垂挂，无中间横拉层）
// =============================================================================

// 左框架左右立柱柱心距（沿 +X，mm）— 放普通中塔
leftFrameWidth = 300;

// =============================================================================
// 派生（由主参数计算，勿手改；特殊覆盖写在分框架区）
// =============================================================================

// 框架顶面 Z = 桌面底 = 顶内丝法兰承面（地面起算）
frameHeight = table_height - tabletopThickness;

// 框架平面外包（柱心可用范围，已扣两侧 frameInset）
frameLength = table_length - 2 * frameInset;  // 沿 X
frameWidth  = table_width  - 2 * frameInset;  // 沿 Y（桌深方向）

// crossTieZ 见 standards.scad（由顶三通标高 − 垂挂直管算出）
