// shelf/shelf_config.scad — 墙书架设计手填量（单位 mm）
//
// 只放手填输入；柱位 / 板位 / 管净长由 standards.scad 派生
// 书架独立：不引用桌项目变量

// =============================================================================
// 墙面 / 高度基准（世界坐标）
// =============================================================================

// 贴后墙朝桌面一侧的墙面（法兰承面 Y）
shelfOriginY = 610;

// 下层板上表面（格内侧承面；板压在横管件顶上）
shelfOriginZ = 1565;

// =============================================================================
// 格内净空
// =============================================================================

// 格内净高（下层板顶 → 上层板底）
shelfClearHeightMm = 340;

// =============================================================================
// 层板外轮廓
// =============================================================================

// 下层板外轮廓长（+X）
shelfLowerBoardLenMm = 1200;

// 上层板外轮廓长（+X；右缘与下层板对齐）
shelfUpperBoardLenMm = 700;

// 层板外轮廓深（前后，世界 −Y 方向外包）
shelfBoardDepthMm = 280;

// 层板厚
shelfThicknessMm = 12;

// 板左右相对端柱心外伸（须 ≥ 孔边距 + 孔半径）
shelfBoardSideMarginMm = 50;

// 孔边缘距木板外轮廓 ≥ 本值（前后柱心边距由此 + 孔径反推）
shelfBoardHoleEdgeClearMm = 20;

// 立柱穿孔：直径 = 管外径(pipeOD) + 本值
shelfBoardHoleExtraMm = 5;

// =============================================================================
// 短立管（端柱堵头段；一端拧入管件、一端拧堵头）
// =============================================================================

// 短管模型净长（管件外缘 → 堵头承口）
shelfStubPipeNetMm = 50;

// =============================================================================
// 与立柱关系（整体左右定位）
// =============================================================================

// 场景占位立柱左缘世界 X（须与 main 中 table_length − cutout_pillar_x 一致）
shelfPillarLeftX = 2270; // 2560 − 290

// 下层板右缘与立柱左缘间距
shelfBoardPillarGapMm = 10;

// =============================================================================
// 左墙书架（后墙左侧延申段；上下层同长 1200）
// =============================================================================

// 左墙延申段左端世界 X（须与 main 中 −wall_extend_left_mm 一致）
shelfLeftWallEndX = -2000;

// 左书架板左缘相对墙端内缩
shelfLeftBoardWallGapMm = 10;

// 左书架上下层板长（两层同 1200）
shelfLeftBoardLenMm = 1200;
